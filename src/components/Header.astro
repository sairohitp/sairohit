---
import { site } from '../config/site';
import { url, isExternal } from '../lib/url';
import Icon from './Icon.astro';
import Preferences from './Preferences.astro';

/* The current section: Work covers the case studies, Blog covers posts. */
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isCurrent = (href: string) => {
  if (href === '/#work') return path.startsWith('/projects/');
  if (href.startsWith('/') && href !== '/') return path.startsWith(href);
  return false;
};
const internal = site.nav.filter((n) => !isExternal(n.href));
const resume = site.nav.find((n) => isExternal(n.href));
---

<header class="nav" data-nav>
  <div class="nav__bar container">
    <a class="nav__brand" href={url('/')} aria-label={`${site.name}, home`}>
      <span class="nav__mark" aria-hidden="true">SR</span>
      <span class="nav__name">{site.name}</span>
    </a>

    <nav class="nav__primary" aria-label="Primary">
      <span class="nav__pill" aria-hidden="true" data-nav-pill></span>
      <ul class="nav__links" data-nav-links>
        {
          site.nav.map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                {...(isExternal(item.href) ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {item.label}
                {isExternal(item.href) && <Icon name="arrow-up-right" size={11} />}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__actions">
      <button class="nav__icon nav__theme" type="button" data-theme-toggle aria-label="Switch between light and dark theme">
        <span class="nav__theme-sun"><Icon name="sun" size={18} /></span>
        <span class="nav__theme-moon"><Icon name="moon" size={18} /></span>
      </button>
      <button class="nav__icon" type="button" data-prefs-open aria-haspopup="dialog" aria-label="Preferences: theme, accessibility, region, language and currency">
        <Icon name="sliders-horizontal" size={18} />
      </button>
      <button class="nav__icon nav__menu" type="button" data-menu-toggle aria-expanded="false" aria-controls="nav-sheet" aria-label="Menu">
        <span class="nav__menu-open"><Icon name="list" size={20} /></span>
        <span class="nav__menu-close"><Icon name="x" size={20} /></span>
      </button>
    </div>
  </div>

  <div id="nav-sheet" class="nav__sheet container" data-menu hidden>
    <div class="nav__sheet-card">
      <ul class="nav__sheet-links">
        {
          internal.map((item, i) => (
            <li style={`--i: ${i}`}>
              <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <span class="nav__sheet-num">{String(i + 1).padStart(2, '0')}</span>
                {item.label}
                <Icon name="arrow-right" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav__sheet-foot">
        {resume && (
          <a class="nav__sheet-resume" href={resume.href} target="_blank" rel="noopener">
            Resume <Icon name="arrow-up-right" size={14} />
          </a>
        )}
        <a class="nav__sheet-resume" href={url('/sitemap/')}>Sitemap <Icon name="arrow-right" size={14} /></a>
        <ul class="nav__sheet-social">
          {
            site.social.map((s) => (
              <li>
                <a href={s.href} aria-label={s.label} target="_blank" rel="noopener"><Icon name={s.icon} size={20} /></a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</header>

<Preferences />
