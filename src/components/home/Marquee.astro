---
import { organisations } from '../../data/profile';
const list = [...organisations, ...organisations];
---

<section class="marquee" aria-label="Organisations I have worked with" data-reveal="fade">
  <p class="visually-hidden">{organisations.join(', ')}</p>
  <div class="marquee__track" aria-hidden="true">
    {
      list.map((o) => (
        <span class="marquee__item">
          {o}
          <span class="marquee__sep">✦</span>
        </span>
      ))
    }
  </div>
</section>
