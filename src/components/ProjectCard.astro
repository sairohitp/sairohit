---
import type { Project } from '../data/types';
import { cardSubtitle, projectHref } from '../data/projects';
import { url } from '../lib/url';
import Icon from './Icon.astro';
import Media from './Media.astro';

interface Props {
  project: Project;
  level?: 'h2' | 'h3';
}

const { project, level = 'h2' } = Astro.props;
const Heading = level;
const thumb = project.thumbnail ?? {
  label: project.platform === 'mobile' ? 'App screens, 1600 x 1032' : 'Browser mockup, 1600 x 1032',
};
---

<a class="pcard" href={url(projectHref(project))}>
  <div class="pcard__head">
    <div>
      <Heading class="pcard__title">{project.title}</Heading>
      <p class="pcard__sub">{cardSubtitle(project)}</p>
    </div>
    <Icon name="arrow-right" size={30} class="pcard__arrow" />
  </div>
  <Media media={thumb} ratio="737 / 476" class="pcard__media" />
</a>
