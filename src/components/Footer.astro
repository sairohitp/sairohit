---
import { site } from '../config/site';
import { url } from '../lib/url';
import Icon from './Icon.astro';
---

<footer class="site-footer container">
  <div class="site-footer__card" data-reveal>
    <div class="site-footer__brand">
      <a class="site-footer__name" href={url('/')}>{site.name}</a>
      <ul class="site-footer__social">
        {
          site.social.map((s) => (
            <li>
              <a href={s.href} aria-label={s.label} target="_blank" rel="noopener">
                <Icon name={s.icon} size={22} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="site-footer__cols">
      {
        site.footer.map((col) => (
          <div class="site-footer__col">
            <p class="site-footer__title">{col.title}</p>
            <ul>
              {col.links.map((l) =>
                l.href ? (
                  <li>
                    <a href={url(l.href)} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>
                      {l.label}
                      {l.external && <Icon name="arrow-up-right" size={14} />}
                    </a>
                  </li>
                ) : (
                  <li>
                    <span class="site-footer__soon">
                      {l.label}
                      <span class="soon-tag">Soon</span>
                    </span>
                  </li>
                ),
              )}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</footer>
