---
import Icon from './Icon.astro';
---

<dialog class="lightbox" data-lightbox aria-label="Image viewer">
  <div class="lightbox__layout">
    <figure class="lightbox__figure">
      <img class="lightbox__img" alt="" data-lightbox-img />
      <figcaption class="lightbox__cap" data-lightbox-cap></figcaption>
    </figure>
    <aside class="lightbox__panel" data-lightbox-panel aria-label="Inside the file" hidden></aside>
  </div>
  <button class="lightbox__btn lightbox__btn--close" type="button" data-lightbox-close aria-label="Close" autofocus><Icon name="x" size={18} /></button>
  <button class="lightbox__btn lightbox__btn--prev" type="button" data-lightbox-prev aria-label="Previous image"><Icon name="caret-left" size={18} /></button>
  <button class="lightbox__btn lightbox__btn--next" type="button" data-lightbox-next aria-label="Next image"><Icon name="caret-right" size={18} /></button>
</dialog>
