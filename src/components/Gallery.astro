---
/** Responsive image grid; every image opens in a shared lightbox. */
import type { Media } from '../data/types';
import { url } from '../lib/url';

interface Props {
  items: (Media & { title?: string; meta?: string; tag?: string; group?: string })[];
  layout?: 'grid' | 'masonry';
  name?: string;
}
const { items, layout = 'grid', name = 'gallery' } = Astro.props;
---

<ul class:list={['gallery', `gallery--${layout}`]} data-gallery={name} data-stagger="40">
  {
    items.map((m, i) => (
      <li class="gallery__item" data-reveal="pop" data-group={m.group}>
        <button
          type="button"
          class="gallery__btn"
          data-lightbox-src={url(m.src!)}
          data-lightbox-alt={m.alt ?? ''}
          data-lightbox-caption={[m.title, m.meta].filter(Boolean).join(' · ')}
          data-index={i}
          aria-label={`Open ${m.title ?? m.alt ?? 'image'}`}
        >
          <img src={url(m.src!)} alt={m.alt ?? ''} loading="lazy" decoding="async" style={m.ratio ? `aspect-ratio: ${m.ratio}` : undefined} />
          {m.tag && <span class="gallery__tag">{m.tag}</span>}
        </button>
        {(m.title || m.meta) && (
          <p class="gallery__cap">
            {m.title && <span class="gallery__title">{m.title}</span>}
            {m.meta && <span class="gallery__meta">{m.meta}</span>}
          </p>
        )}
      </li>
    ))
  }
</ul>
