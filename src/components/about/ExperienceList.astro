---
import Icon from '../Icon.astro';
import { experience, span } from '../../data/profile';
import { projects } from '../../data/projects';
import { url } from '../../lib/url';
---

<div class="xp-acc" data-stagger="80">
  {
    experience.map((x, i) => {
      const project = x.project ? projects.find((p) => p.slug === x.project) : undefined;
      return (
        <details class="xp-item" open={i === 0} data-reveal="rise">
          <summary class="xp-item__head">
            <span class="xp-item__icon">
              <Icon name={x.icon} size={18} />
            </span>
            <span class="xp-item__titles">
              <span class="xp-item__org">
                {x.org}
                <span class={`kind kind--${x.kind.toLowerCase()}`}>{x.kind}</span>
              </span>
              <span class="xp-item__role">{x.roles[0].title}</span>
            </span>
            <span class="xp-item__span">
              {span(x)}
              {x.location && <span class="xp-item__loc">{x.location}</span>}
            </span>
            <span class="xp-item__toggle" aria-hidden="true">
              <Icon name="plus" size={16} />
            </span>
          </summary>
          <div class="xp-item__body">
            {x.metrics && (
              <ul class="metrics">
                {x.metrics.map((m) => (
                  <li class="metric">
                    <span class="metric__value">{m.value}</span>
                    <span class="metric__label">{m.label}</span>
                  </li>
                ))}
              </ul>
            )}
            {x.roles.map((r) => (
              <div class="xp-role">
                <p class="xp-role__title">
                  {r.title}
                  <span class="xp-role__dates">{r.dates}</span>
                </p>
                {r.points.length > 0 && (
                  <ul class="xp-role__points">
                    {r.points.map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
            {project && (
              <a class="link-arrow" href={url(`/projects/${project.slug}/`)}>
                Read the {project.title} case study <Icon name="arrow-right" size={16} />
              </a>
            )}
          </div>
        </details>
      );
    })
  }
</div>
