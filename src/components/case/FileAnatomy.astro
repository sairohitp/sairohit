---
import Icon from '../Icon.astro';
import { frameKind, fileAnchor, type FigFile } from '../../data/figma';

interface Props {
  files: FigFile[];
  /** Compact layout for the Visual page: fewer panels open. */
  compact?: boolean;
}

const { files, compact = false } = Astro.props;
const fmt = (n: number) => n.toLocaleString('en-IN');
const FRAME_LIMIT = 36;
const plural = (n: number, one: string, many = `${one}s`) => `${n.toLocaleString('en-IN')} ${n === 1 ? one : many}`;
---

<div class:list={['anatomy', compact && 'anatomy--compact']}>
  {
    files.map((f) => {
      const kinds = new Map<string, number>();
      f.pages.forEach((p) => p.frames.forEach((fr) => kinds.set(frameKind(fr.w, fr.h), (kinds.get(frameKind(fr.w, fr.h)) ?? 0) + 1)));
      const maxSize = Math.max(...f.sizes.map(([s]) => s), 1);
      return (
        <article id={fileAnchor(f.key)} class="fig-file" data-reveal="fade">
          <header class="fig-file__head">
            <span class="fig-file__icon"><Icon name="figma" size={18} /></span>
            <div>
              <h3 class="fig-file__title">{f.title}</h3>
              <p class="fig-file__meta">
                {[...kinds.entries()].sort((a, b) => b[1] - a[1]).slice(0, 4).map(([k, n]) => `${n} ${k.toLowerCase()}`).join(' · ')}
              </p>
            </div>
          </header>

          <ul class="fig-stats" data-stagger="60">
            {[
              ['Pages', f.stats.pages],
              ['Frames', f.stats.frames],
              ['Layers', f.stats.layers],
              ['Text layers', f.stats.textLayers],
              ['Components', f.stats.components],
              ['Prototype links', f.stats.prototypeLinks],
            ].map(([label, value]) => (
              <li data-reveal="pop">
                <span class="fig-stats__value" data-count={value}>{fmt(value as number)}</span>
                <span class="fig-stats__label">{label}</span>
              </li>
            ))}
          </ul>

          <details class="fig-panel" open={!compact || undefined}>
            <summary><Icon name="tree-structure" size={15} /> Pages and frames <span>{plural(f.stats.pages, 'page')}, {plural(f.stats.frames, 'frame')}</span></summary>
            <ol class="fig-pages">
              {f.pages.map((p, pi) => (
                <li class="fig-page">
                  <p class="fig-page__name">
                    <span class="fig-page__num">{String(pi + 1).padStart(2, '0')}</span>
                    {p.name}
                    <span class="fig-page__count">{p.frames.length} {p.frames.length === 1 ? 'frame' : 'frames'}</span>
                  </p>
                  {p.frames.length > 0 && (
                    <ul class="fig-frames">
                      {p.frames.slice(0, FRAME_LIMIT).map((fr) => (
                        <li title={`${fr.w} × ${fr.h}${fr.s ? `, in section ${fr.s}` : ''}`}>
                          {fr.n}
                          <span>{fr.w}×{fr.h}</span>
                          {fr.l && <span class="fig-frames__link" title={`${fr.l} prototype links`}>{fr.l}↗</span>}
                        </li>
                      ))}
                      {p.frames.length > FRAME_LIMIT && (
                        <li class="fig-frames__more">
                          <details>
                            <summary>+{p.frames.length - FRAME_LIMIT} more</summary>
                            <ul class="fig-frames">
                              {p.frames.slice(FRAME_LIMIT).map((fr) => (
                                <li>{fr.n}<span>{fr.w}×{fr.h}</span></li>
                              ))}
                            </ul>
                          </details>
                        </li>
                      )}
                    </ul>
                  )}
                </li>
              ))}
            </ol>
          </details>

          {(f.fonts.length > 0 || f.colors.length > 0) && (
            <details class="fig-panel" open={!compact || undefined}>
              <summary><Icon name="text-aa" size={15} /> Type and colour <span>{plural(f.fonts.length, 'family', 'families')}, {plural(f.colors.length, 'key colour')}</span></summary>
              <div class="fig-style">
                <div>
                  <p class="fig-label">Typefaces</p>
                  <ul class="fig-fonts">
                    {f.fonts.map((ft) => (
                      <li>
                        <span class="fig-fonts__sample" style={`font-family: '${ft.family}', var(--font)`}>Aa</span>
                        <span class="fig-fonts__name">{ft.family}</span>
                        <span class="fig-fonts__styles">{ft.styles.join(', ')} · {fmt(ft.count)} layers</span>
                      </li>
                    ))}
                  </ul>
                  {f.sizes.length > 0 && (
                    <>
                      <p class="fig-label">Most used sizes</p>
                      <ul class="fig-sizes">
                        {f.sizes.map(([s, n]) => (
                          <li style={`--h: ${Math.max(10, (s / maxSize) * 100)}%`} title={`${s}px, ${n} layers`}>
                            <span class="fig-sizes__bar" />
                            <span class="fig-sizes__label">{s}</span>
                          </li>
                        ))}
                      </ul>
                    </>
                  )}
                </div>
                <div>
                  <p class="fig-label">Colours by use</p>
                  <ul class="fig-colors">
                    {f.colors.map(([hex, n]) => (
                      <li>
                        <span class="fig-colors__chip" style={`background: ${hex}`} />
                        <span class="fig-colors__hex">{hex}</span>
                        <span class="fig-colors__n">{fmt(n)}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </details>
          )}

          {(f.components.length > 0 || f.instances.length > 0) && (
            <details class="fig-panel">
              <summary><Icon name="code-simple" size={15} /> Components <span>{f.stats.components} defined, {fmt(f.stats.instances)} instances</span></summary>
              {f.components.length > 0 && (
                <>
                  <p class="fig-label">Defined in this file</p>
                  <ul class="fig-chips">{f.components.map(([c, n]) => <li>{c || 'Unnamed'}{n > 1 && <span>×{n}</span>}</li>)}</ul>
                </>
              )}
              {f.instances.length > 0 && (
                <>
                  <p class="fig-label">Most used instances</p>
                  <ul class="fig-chips">{f.instances.map(([c, n]) => <li>{c}<span>×{fmt(n)}</span></li>)}</ul>
                </>
              )}
            </details>
          )}

        </article>
      );
    })
  }
</div>
