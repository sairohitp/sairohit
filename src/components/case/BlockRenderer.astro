---
import type { Block } from '../../data/types';
import Callout from './Callout.astro';
import ExhibitFigure from './ExhibitFigure.astro';
import InfoCard from './InfoCard.astro';
import Flow from './Flow.astro';
import Tree from './Tree.astro';
import Palette from './Palette.astro';
import Stats from './Stats.astro';
import Compare from './Compare.astro';
import Faq from './Faq.astro';
import Goals from './Goals.astro';
import Gallery from '../Gallery.astro';
import Caption from './Caption.astro';

interface Props {
  block: Block;
}

const { block } = Astro.props;

/*
 * Text blocks pick a layout from their content, so wide pages never leave a half-empty column:
 * "lede"  heading and paragraphs: a display heading beside a lead paragraph.
 * "split" heading, paragraphs and an icon list: the intro sits beside the list.
 * "grid"  heading and cards: an intro row, then the cards in a numbered row across the full width.
 */
const textVariant =
  block.type === 'text' ? (block.cards?.length ? 'grid' : block.list?.length ? 'split' : 'lede') : null;
const heading = block.type === 'text' ? block.heading.replace(/:\s*$/, '') : '';
const gridCols = block.type === 'text' && block.cards?.length ? (block.cards.length <= 4 ? block.cards.length : 3) : 0;
---

{
  block.type === 'meta' && (
    <div class="two-col meta">
      <dl class="meta__list" data-stagger="110">
        <div data-reveal="left">
          <dt>My Role</dt>
          <dd>{block.role}</dd>
        </div>
        {block.team?.length ? (
          <div data-reveal="left">
            <dt>Team</dt>
            <dd>
              <ul>
                {block.team.map((m) => (
                  <li>{m}</li>
                ))}
              </ul>
            </dd>
          </div>
        ) : null}
        <div data-reveal="left">
          <dt>Timeline &amp; Status</dt>
          <dd>{block.timeline}</dd>
        </div>
      </dl>
      <div class="meta__overview" data-stagger="110">
        <h2 class="meta__heading" data-reveal>
          Overview
        </h2>
        {block.overview.map((p) => (
          <p data-reveal>{p}</p>
        ))}
      </div>
    </div>
  )
}

{
  block.type === 'text' && textVariant !== 'grid' && (
    <div class:list={['text-block', `text-block--${textVariant}`]}>
      <div class="text-block__aside">
        <span class="text-block__rule" aria-hidden="true" />
        <h3 class="text-block__heading" data-reveal="left">{heading}</h3>
        {textVariant === 'split' && block.body?.length ? (
          <div class="text-block__intro" data-stagger="90">
            {block.body.map((p) => (
              <p data-reveal>{p}</p>
            ))}
          </div>
        ) : null}
      </div>
      <div class="text-block__body" data-stagger="90">
        {textVariant === 'lede' &&
          block.body?.map((p, i) => (
            <p class:list={[i === 0 && 'is-lede']} data-reveal>
              {p}
            </p>
          ))}
        {textVariant === 'split' && (
          <ol class="card-stack card-stack--numbered" data-stagger="90">
            {(block.list ?? []).map((c, i) => (
              <InfoCard card={c} variant="inline" index={i} />
            ))}
          </ol>
        )}
      </div>
    </div>
  )
}

{
  block.type === 'text' && textVariant === 'grid' && (
    <div class="text-block text-block--grid">
      <div class="text-block__head">
        <div class="text-block__aside">
          <span class="text-block__rule" aria-hidden="true" />
          <h3 class="text-block__heading" data-reveal="left">{heading}</h3>
        </div>
        {block.body?.length ? (
          <div class="text-block__body" data-stagger="90">
            {block.body.map((p, i) => (
              <p class:list={[i === 0 && 'is-lede']} data-reveal>
                {p}
              </p>
            ))}
          </div>
        ) : (
          <p class="text-block__count" data-reveal>
            {(block.cards ?? []).length} {(block.cards ?? []).length === 1 ? 'point' : 'points'}
          </p>
        )}
      </div>
      {block.list?.length ? (
        <ol class="card-stack card-stack--numbered" data-stagger="90">
          {block.list.map((c, i) => (
            <InfoCard card={c} variant="inline" index={i} />
          ))}
        </ol>
      ) : null}
      <ol class="card-row" style={`--cols: ${gridCols}`} data-stagger="90">
        {(block.cards ?? []).map((c, i) => (
          <InfoCard card={c} index={i} />
        ))}
      </ol>
    </div>
  )
}

{block.type === 'exhibit' && <ExhibitFigure exhibit={block} />}

{
  block.type === 'exhibitPair' && (
    <div class="pair">
      {block.items.map((item) => (
        <div class="pair__item">
          <ExhibitFigure exhibit={item} ratio="3 / 4" />
          {item.cards?.length ? (
            <ul class="card-stack" data-stagger="90">
              {item.cards.map((c) => (
                <InfoCard card={c} />
              ))}
            </ul>
          ) : null}
        </div>
      ))}
    </div>
  )
}

{
  block.type === 'cardGrid' && (
    <ul class="card-grid" data-stagger="80">
      {block.cards.map((c) => (
        <InfoCard card={c} />
      ))}
    </ul>
  )
}

{block.type === 'callout' && <Callout block={block} />}
{block.type === 'flow' && <Flow steps={block.steps} caption={block.caption} />}
{block.type === 'tree' && <Tree root={block.root} groups={block.groups} caption={block.caption} />}
{block.type === 'palette' && <Palette swatches={block.swatches} caption={block.caption} />}
{block.type === 'stats' && <Stats items={block.items} />}
{block.type === 'compare' && <Compare base={block.base} top={block.top} caption={block.caption} />}
{block.type === 'faq' && <Faq items={block.items} />}
{block.type === 'goals' && <Goals items={block.items} caption={block.caption} />}
{
  block.type === 'gallery' && (
    <figure class="screens">
      <Gallery items={block.items} />
      {block.caption && <Caption caption={block.caption} />}
    </figure>
  )
}
