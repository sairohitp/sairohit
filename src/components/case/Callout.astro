---
import type { Block } from '../../data/types';
import Icon from '../Icon.astro';
import ExhibitFigure from './ExhibitFigure.astro';

interface Props {
  block: Extract<Block, { type: 'callout' }>;
}

const { block } = Astro.props;
---

<div class:list={['callout', block.exhibits?.length && 'callout--with-exhibits']}>
  <div class="callout__head">
    {
      block.icon && (
        <span class="callout__icon">
          <Icon name={block.icon} size={20} />
        </span>
      )
    }
    <p class="callout__label">{block.label}</p>
    <p class="callout__statement">{block.statement}</p>
  </div>
  {
    block.exhibits?.length ? (
      <div class="callout__exhibits">
        {block.exhibits.map((e) => (
          <ExhibitFigure exhibit={e} />
        ))}
      </div>
    ) : null
  }
</div>
