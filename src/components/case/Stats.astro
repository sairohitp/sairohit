---
import type { Stat } from '../../data/types';

interface Props {
  items: Stat[];
}

const { items } = Astro.props;
---

<ul class="stats" data-stagger="120">
  {
    items.map((s) => (
      <li class="stats__item" data-reveal="pop">
        <span class="stats__value" data-count={s.value} data-prefix={s.prefix ?? ''} data-suffix={s.suffix ?? ''}>
          {s.prefix}
          {s.value}
          {s.suffix}
        </span>
        <span class="stats__label">{s.label}</span>
      </li>
    ))
  }
</ul>
