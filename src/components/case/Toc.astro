---
import type { Section } from '../../data/types';

interface Props {
  sections: Section[];
}

const { sections } = Astro.props;
---

<nav class="toc" aria-label="Contents">
  <p class="toc__title">Contents</p>
  <ul>
    {
      sections.map((s) => (
        <li>
          <a href={`#${s.id}`} data-toc-link={s.id}>
            {s.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  // Highlight the contents entry for the section currently in view.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((a) => {
    links.set(a.dataset.tocLink!, a);
  });

  const setActive = (id: string) => {
    links.forEach((a, key) => {
      if (key === id) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    },
    { rootMargin: '-35% 0px -60% 0px' },
  );

  links.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
</script>
