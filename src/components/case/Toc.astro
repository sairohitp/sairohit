---
import Icon from '../Icon.astro';

interface Props {
  sections: { id: string; label: string }[];
  title?: string;
}

const { sections, title = 'Contents' } = Astro.props;
---

<nav class="toc" aria-label={title}>
  <p class="toc__title">{title}</p>
  <ol>
    {
      sections.map((s, i) => (
        <li>
          <a href={`#${s.id}`} data-toc-link={s.id}>
            <span class="toc__arrow" aria-hidden="true"><Icon name="arrow-right" size={12} /></span>
            <span class="toc__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="toc__label">{s.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  // Highlight the contents entry for the section currently in view.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((a) => {
    links.set(a.dataset.tocLink!, a);
  });

  const setActive = (id: string) => {
    links.forEach((a, key) => {
      if (key === id) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    },
    { rootMargin: '-35% 0px -60% 0px' },
  );

  links.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
</script>
