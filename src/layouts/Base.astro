---
import '@fontsource-variable/inter';
import '@fontsource-variable/inter/wght-italic.css';
import '../styles/global.css';
import '../styles/site.css';
import '../styles/case.css';
import '../styles/diagrams.css';
import '../styles/about.css';
import '../styles/home.css';
import '../styles/about-v2.css';
import '../styles/blog.css';
import '../styles/gallery.css';
import '../styles/motion.css';
import '../styles/tiles.css';
import '../styles/nav.css';
import '../styles/pages.css';
import '../styles/anatomy.css';
import { site } from '../config/site';
import { url } from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactBand from '../components/ContactBand.astro';
import Lightbox from '../components/Lightbox.astro';
import { graph, abs } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** Social share image in /public, e.g. "/og/home.jpg". */
  image?: string;
  /** Wider page container, used by the home page grid. */
  wide?: boolean;
  /** Keep this page out of search results. */
  noindex?: boolean;
  /** Open Graph type: articles for case studies and posts, profile for About. */
  type?: 'website' | 'article' | 'profile';
  published?: Date;
  modified?: Date;
  tags?: string[];
  /** Extra schema.org nodes for this page (the site and person are always included). */
  schema?: object[];
  /** Alt text for the share image. */
  imageAlt?: string;
}

const {
  title = site.title,
  description = site.description,
  wide = false,
  noindex = false,
  type = 'website',
  published,
  modified,
  tags = [],
  schema = [],
  imageAlt = `${site.name}, product designer`,
} = Astro.props;
const image = Astro.props.image ?? '/og/home.jpg';
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = abs(image);
const jsonLd = JSON.stringify(graph(schema)).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      // Apply saved preferences before paint (theme, accessibility, region). See src/scripts/prefs.ts.
      (function () {
        var d = document.documentElement, p = {};
        d.classList.add('js');
        try { p = JSON.parse(localStorage.getItem('prefs') || '{}') || {}; } catch (e) {}
        var t = p.theme || 'dark';
        var dark = t === 'dark' || (t === 'system' && !matchMedia('(prefers-color-scheme: light)').matches);
        d.dataset.theme = dark ? 'dark' : 'light';
        ['motion', 'text', 'contrast', 'links', 'spacing'].forEach(function (k) {
          if (p[k] && p[k] !== 'default' && p[k] !== 'system') d.dataset[k] = p[k];
        });
        if (p.region) d.dataset.region = p.region;
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Pusarla Sai Rohit" />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="theme-color" content="#111111" />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="Sai Rohit | Blog" href={url('/rss.xml')} />
    <link rel="sitemap" type="application/xml" href={url('/sitemap.xml')} />
    <link rel="author" href={url('/about/')} />

    <!-- Open Graph and social cards -->
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {type === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === 'article' && modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={url('/about/')} />}
    {type === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}
    {type === 'profile' && <meta property="profile:first_name" content="Sai Rohit" />}
    {type === 'profile' && <meta property="profile:last_name" content="Pusarla" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Structured data for search engines and AI assistants -->
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class:list={[wide && 'page--wide']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <ContactBand />
    <Footer />
    <Lightbox />
    <script>
      import { initMotion } from '../scripts/motion';
      import { initPrefs } from '../scripts/prefs';
      initPrefs();
      initMotion();
    </script>
  </body>
</html>
