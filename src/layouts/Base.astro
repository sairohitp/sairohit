---
import '@fontsource-variable/inter';
import '@fontsource-variable/inter/wght-italic.css';
import '../styles/global.css';
import '../styles/site.css';
import '../styles/case.css';
import '../styles/diagrams.css';
import '../styles/about.css';
import '../styles/home.css';
import '../styles/about-v2.css';
import '../styles/blog.css';
import '../styles/gallery.css';
import '../styles/motion.css';
import '../styles/tiles.css';
import '../styles/nav.css';
import '../styles/pages.css';
import { site } from '../config/site';
import { url } from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactBand from '../components/ContactBand.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title?: string;
  description?: string;
  /** Social share image in /public, e.g. "/og/home.jpg". */
  image?: string;
  /** Wider page container, used by the home page grid. */
  wide?: boolean;
  /** Keep this page out of search results. */
  noindex?: boolean;
}

const { title = site.title, description = site.description, wide = false, noindex = false } = Astro.props;
const image = Astro.props.image ?? '/og/home.jpg';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      // Apply saved preferences before paint (theme, accessibility, region). See src/scripts/prefs.ts.
      (function () {
        var d = document.documentElement, p = {};
        d.classList.add('js');
        try { p = JSON.parse(localStorage.getItem('prefs') || '{}') || {}; } catch (e) {}
        var t = p.theme || 'dark';
        var dark = t === 'dark' || (t === 'system' && !matchMedia('(prefers-color-scheme: light)').matches);
        d.dataset.theme = dark ? 'dark' : 'light';
        ['motion', 'text', 'contrast', 'links', 'spacing'].forEach(function (k) {
          if (p[k] && p[k] !== 'default' && p[k] !== 'system') d.dataset[k] = p[k];
        });
        if (p.region) d.dataset.region = p.region;
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#111111" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="Sai Rohit | Blog" href={url('/rss.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(url(image), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={[wide && 'page--wide']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <ContactBand />
    <Footer />
    <Lightbox />
    <script>
      import { initMotion } from '../scripts/motion';
      import { initPrefs } from '../scripts/prefs';
      initPrefs();
      initMotion();
    </script>
  </body>
</html>
