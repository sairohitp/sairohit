---
import '@fontsource-variable/inter';
import '@fontsource-variable/inter/wght-italic.css';
import '../styles/global.css';
import '../styles/site.css';
import '../styles/case.css';
import '../styles/diagrams.css';
import '../styles/about.css';
import '../styles/home.css';
import '../styles/about-v2.css';
import '../styles/motion.css';
import { site } from '../config/site';
import { url } from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactBand from '../components/ContactBand.astro';

interface Props {
  title?: string;
  description?: string;
  /** Social share image in /public, e.g. "/og/home.jpg". */
  image?: string;
  /** Wider page container, used by the home page grid. */
  wide?: boolean;
}

const { title = site.title, description = site.description, image = '/og/home.jpg', wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111111" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(url(image), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={[wide && 'page--wide']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <ContactBand />
    <Footer />
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
