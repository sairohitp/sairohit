---
import { projects, projectHref } from '../data/projects';
import { abs, personId } from '../lib/seo';
const homeSchema = [
  {
    '@type': 'ItemList',
    name: 'Case studies',
    itemListElement: projects.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(projectHref(p)), name: p.title })),
  },
  { '@type': 'ProfilePage', url: abs('/'), mainEntity: { '@id': personId } },
];
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Glance from '../components/home/Glance.astro';
import WorkList from '../components/home/WorkList.astro';
import Built from '../components/home/Built.astro';
import ExperiencePreview from '../components/home/ExperiencePreview.astro';
import Writing from '../components/home/Writing.astro';
import Explorations from '../components/home/Explorations.astro';
import VisualTeaser from '../components/home/VisualTeaser.astro';
---

<Base
  wide
  title="Sai Rohit | Product Designer in Bengaluru, Figma to React"
  description="Sai Rohit, product designer in Bengaluru: data-heavy enterprise products designed in Figma and built in React. 12 case studies, visual design and writing."
  schema={homeSchema}
>
  <Hero />
  <Glance />
  <WorkList />
  <Explorations />
  <VisualTeaser />
  <Built />
  <ExperiencePreview />
  <Writing />
</Base>
