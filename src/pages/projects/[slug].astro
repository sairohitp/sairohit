---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Media from '../../components/Media.astro';
import Words from '../../components/Words.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import BlockRenderer from '../../components/case/BlockRenderer.astro';
import FileAnatomy from '../../components/case/FileAnatomy.astro';
import { filesFor, fileAnchor } from '../../data/figma';
import { abs, personId, breadcrumbs, faqPage, clampText } from '../../lib/seo';
import Toc from '../../components/case/Toc.astro';
import { projects, pageSubtitle, nextProject } from '../../data/projects';
import type { Project } from '../../data/types';
import { site } from '../../config/site';
import { url } from '../../lib/url';
import PostCard from '../../components/blog/PostCard.astro';
import { getPosts } from '../../lib/blog';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { cover, sections } = project.caseStudy;
const next = nextProject(project);
const subtitle = pageSubtitle(project);
const related = (await getPosts()).filter((p) => p.data.related === project.slug);
const og = existsSync(join(process.cwd(), 'public/og', `${project.slug}.jpg`)) ? `/og/${project.slug}.jpg` : undefined;
const visualLink = ['events-booking-portal', 'event-registration', 'gdsc-srm-web-and-brand'].includes(project.slug);
const figFiles = filesFor('project', project.slug);
const figNum = String(sections.length + 1).padStart(2, '0');
const tocSections = [...sections.map((s) => ({ id: s.id, label: s.label })), ...(figFiles.length
    ? [{ id: 'figma-files', label: 'Inside the files', children: figFiles.map((f) => ({ id: fileAnchor(f.key), label: f.title.replace(/\.fig$/, '') })) }]
    : [])];
const figTotals = figFiles.reduce((t, f) => ({ pages: t.pages + f.stats.pages, frames: t.frames + f.stats.frames, layers: t.layers + f.stats.layers, links: t.links + f.stats.prototypeLinks }), { pages: 0, frames: 0, layers: 0, links: 0 });
const faqItems = sections.flatMap((s) => s.blocks.flatMap((b) => (b.type === 'faq' ? b.items : [])));
const csSchema = [
  {
    '@type': 'CreativeWork',
    '@id': `${abs(`/projects/${project.slug}/`)}#work`,
    name: project.title,
    headline: `${project.title} case study`,
    genre: 'UX case study',
    url: abs(`/projects/${project.slug}/`),
    image: abs(og ?? '/og/home.jpg'),
    author: { '@id': personId },
    creator: { '@id': personId },
    keywords: [project.platform === 'mobile' ? 'Mobile app' : 'Web app', ...(project.tags ?? []), 'UX design', 'UI design', 'Figma'].join(', '),
    ...(project.figma ? { sameAs: project.figma } : {}),
  },
  breadcrumbs([{ name: 'Work', path: '/#work' }, { name: project.title, path: `/projects/${project.slug}/` }]),
];
const firstOverview = sections.find((s) => s.blocks[0]?.type === 'meta')?.blocks[0];
const description = clampText(
  firstOverview && firstOverview.type === 'meta' ? firstOverview.overview[0] : `${project.title}: ${subtitle}.`,
);
---

<Base
  title={`${project.title} case study | ${site.name}`}
  description={description}
  image={og}
  imageAlt={`${project.title}, cover`}
  type="article"
  tags={[project.platform === 'mobile' ? 'Mobile' : 'Web', ...(project.tags ?? [])]}
  schema={[...csSchema, ...(faqItems.length ? [faqPage(faqItems)] : [])]}
  wide
>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
  <div class="cs">
    <aside class="cs__left">
      <a class="back-pill" href={url('/')} data-reveal="left">
        <Icon name="arrow-left" size={14} />
        Back
      </a>
    </aside>

    <article class="cs__main">
      <header class="cs-hero">
        <a class="back-pill back-pill--inline" href={url('/')}>
          <Icon name="arrow-left" size={14} />
          Back
        </a>
        <h1 class="cs-hero__title split"><Words text={project.title} /></h1>
        <p class="cs-hero__sub" data-reveal>{subtitle}</p>
        {
          project.figma && (
            <a class="figma-pill" href={project.figma} target="_blank" rel="noopener" data-reveal="pop">
              <Icon name="figma" size={14} />
              View in Figma
              <Icon name="arrow-up-right" size={12} />
            </a>
          )
        }
      </header>

      <div class="cs-cover-wrap" data-reveal="clip">
        <Media media={cover} ratio="750 / 430" class="cs-cover" eager />
      </div>

      {
        sections.map((s, i) => (
          <section id={s.id} class="cs-section" aria-label={s.title ? undefined : s.label}>
            {s.divider !== false && <hr class="cs-divider" data-reveal="line" />}
            {s.title && (
              <header class="section-head" data-reveal="blur">
                <p class="section-head__eyebrow">
                  <span class="section-head__num">{String(i + 1).padStart(2, '0')}</span>
                  {s.label}
                </p>
                <h2 class="section-head__title">{s.title}</h2>
              </header>
            )}
            <div class="cs-blocks">
              {s.blocks.map((b) => (
                <BlockRenderer block={b} />
              ))}
            </div>
          </section>
        ))
      }

      {
        figFiles.length > 0 && (
          <section id="figma-files" class="cs-section">
            <hr class="cs-divider" data-reveal="line" />
            <header class="section-head" data-reveal="blur">
              <p class="section-head__eyebrow"><span class="section-head__num">{figNum}</span> Inside the files</p>
              <h2 class="section-head__title">Everything in the Figma {figFiles.length === 1 ? 'file' : 'files'}</h2>
            </header>
            <p class="anatomy__lead" data-reveal>
              This project lives in {figFiles.length === 1 ? 'one Figma file' : `${figFiles.length} Figma files`}: {figTotals.pages} pages,{' '}
              {figTotals.frames.toLocaleString('en-IN')} frames and {figTotals.layers.toLocaleString('en-IN')} layers
              {figTotals.links > 0 && <>, wired together by {figTotals.links.toLocaleString('en-IN')} prototype links</>}. Every page, frame, typeface,
              colour and component is listed below, straight from the source.
            </p>
            <FileAnatomy files={figFiles} />
          </section>
        )
      }

      {
        (related.length > 0 || visualLink) && (
          <section class="cs-related" aria-labelledby="related-title">
            <hr class="cs-divider" data-reveal="line" />
            <h2 id="related-title" class="cs-next__title" data-reveal="left">Related</h2>
            <ul class="blog-grid blog-grid--two">
              {related.map((p) => <li><PostCard post={p} /></li>)}
              {visualLink && (
                <li>
                  <a class="related-visual" href={url('/visual/')} data-reveal="rise">
                    <span class="eyebrow">Visual design</span>
                    <span class="related-visual__title">GDG SRM campaigns, posts and certificates</span>
                    <span class="post-card__more">See the work <Icon name="arrow-right" size={14} /></span>
                  </a>
                </li>
              )}
            </ul>
          </section>
        )
      }

      <section class="cs-next" aria-labelledby="next-title">
        <hr class="cs-divider" data-reveal="line" />
        <h2 id="next-title" class="cs-next__title" data-reveal="left">Next Project:</h2>
        <ProjectCard project={next} level="h3" />
      </section>
    </article>

    <aside class="cs__right">
      <Toc sections={tocSections} />
    </aside>
  </div>
</Base>
