---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Stats from '../components/case/Stats.astro';
import CareerTimeline from '../components/about/CareerTimeline.astro';
import ExperienceList from '../components/about/ExperienceList.astro';
import SkillsTabs from '../components/about/SkillsTabs.astro';
import Education from '../components/about/Education.astro';
import Faq from '../components/case/Faq.astro';
import Toc from '../components/case/Toc.astro';
import { aboutToc } from '../data/routes';
import { profile, leadership, certifications, achievements } from '../data/profile';
import { site } from '../config/site';
import { url } from '../lib/url';

const photo = (id: string) => url(`/images/about/${id}.webp`);
const slides = [
  { src: photo('79B7qdfLfrper1I1AfeViPPk'), alt: 'The GDG SRM team on stage after the UI/UX session' },
  { src: photo('YX4uyZeLMjwymviQBh84iBE1wZA'), alt: 'Participants holding their certificates' },
  { src: photo('L70FHMjnOg87X42WCjVMz57wN8'), alt: 'The auditorium audience during the session' },
];
const [gdg, tedx] = leadership;
const toc = aboutToc;
const n = (id: string) => String(toc.findIndex((t) => t.id === id) + 1).padStart(2, '0');
---

<Base title={`About | ${site.name}`} description={profile.headline} wide>
  <div class="cs">
  <aside class="cs__left">
    <a class="back-pill" href={url('/')} data-reveal="left"><Icon name="arrow-left" size={14} /> Back</a>
  </aside>
  <div class="about cs__main">
    <a class="back-pill back-pill--inline" href={url('/')}><Icon name="arrow-left" size={14} /> Back</a>
    <!-- Intro -->
    <section id="intro" class="about__intro" aria-labelledby="about-title">
      <p class="eyebrow" data-reveal><span class="eyebrow__num">{n('intro')}</span> About me</p>
      <h1 id="about-title" class="about__lead" data-reveal="blur">
        I’m {profile.name}, a <em class="accent">product designer</em> with a computer science foundation, turning complex
        enterprise problems into clear, usable tools.
      </h1>
      <div class="about__summary" data-stagger="100">
        {profile.summary.map((p) => <p data-reveal>{p}</p>)}
      </div>
      <ul class="facts" data-stagger="80">
        <li data-reveal="pop"><Icon name="map-pin" size={14} /> {profile.location}</li>
        <li data-reveal="pop"><Icon name="briefcase" size={14} /> {profile.now.join(' · ')}</li>
        <li data-reveal="pop"><Icon name="graduation-cap" size={14} /> B.Tech, SRM IST, CGPA 9.0</li>
      </ul>
    </section>

    <hr class="about__divider" data-reveal="line" />

    <!-- Timeline -->
    <section id="timeline" class="about__block" aria-labelledby="timeline-title">
      <div class="section-intro">
        <div>
          <p class="eyebrow" data-reveal><span class="eyebrow__num">{n('timeline')}</span> Career at a glance</p>
          <h2 id="timeline-title" class="section-intro__title" data-reveal="blur">Overlapping chapters since 2021</h2>
        </div>
      </div>
      <CareerTimeline />
    </section>

    <hr class="about__divider" data-reveal="line" />

    <!-- Experience -->
    <section id="experience" class="about__block" aria-labelledby="experience-title">
      <div class="section-intro">
        <div>
          <p class="eyebrow" data-reveal><span class="eyebrow__num">{n('experience')}</span> Experience</p>
          <h2 id="experience-title" class="section-intro__title" data-reveal="blur">Business, design and building</h2>
        </div>
        <a class="link-arrow" href={site.resume} target="_blank" rel="noopener" data-reveal>Resume <Icon name="arrow-up-right" size={14} /></a>
      </div>
      <ExperienceList />
    </section>

    <hr class="about__divider" data-reveal="line" />

    <!-- Leadership -->
    <section id="leadership" class="about__block" aria-labelledby="leadership-title">
      <div class="section-intro">
        <div>
          <p class="eyebrow" data-reveal><span class="eyebrow__num">{n('leadership')}</span> Leadership</p>
          <h2 id="leadership-title" class="section-intro__title" data-reveal="blur">Teaching, leading and running events</h2>
        </div>
      </div>

      <article class="lead-card" data-reveal="rise">
        <header class="lead-card__head">
          <p class="lead-card__org"><Icon name="microphone-stage" size={18} /> {gdg.org}</p>
          <ul class="lead-card__roles">
            {gdg.roles.map((r) => <li>{r.title} <span>{r.dates}</span></li>)}
          </ul>
        </header>
        <h3 class="about__heading">Keynote on UI/UX design fundamentals, to 1,200+ students and faculty</h3>
      </article>

      <div class="carousel" data-carousel data-reveal="clip" aria-roledescription="carousel" aria-label="Keynote photos">
        <div class="carousel__viewport">
          <ul class="carousel__track" data-track>
            {
              slides.map((s, i) => (
                <li class="carousel__slide" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`}>
                  <img src={s.src} alt={s.alt} loading="lazy" decoding="async" />
                </li>
              ))
            }
          </ul>
        </div>
        <button class="carousel__btn carousel__btn--prev" type="button" data-prev aria-label="Previous photo"><Icon name="caret-left" size={16} /></button>
        <button class="carousel__btn carousel__btn--next" type="button" data-next aria-label="Next photo"><Icon name="caret-right" size={16} /></button>
        <div class="carousel__dots" role="group" aria-label="Choose photo">
          {slides.map((_, i) => <button type="button" class="carousel__dot" data-dot={i} aria-label={`Show photo ${i + 1}`} aria-current={i === 0 ? 'true' : undefined} />)}
        </div>
      </div>

      <div class="about__split">
        <figure class="about__photo" data-reveal="rise">
          <img src={photo('ME3amptaMRt1aOc3YmPXqJxzvk')} alt="At the podium during the UI/UX session" loading="lazy" decoding="async" />
        </figure>
        <div class="about__copy" data-stagger="110">
          <p data-reveal>
            I started with the basics, explaining the interface and moving around objects, progressing to an interactive
            level where I engaged participants in creating fun illustrations such as the Figma logo, a chemical flask, and a
            teddy bear, progressing to the wireframe and high-fidelity design of their personal blog.
          </p>
          <p data-reveal>
            I was particularly astonished when the ground force team reported that more than 90% of the audience actively
            followed my instructions. This created a positive and engaging momentum throughout the auditorium, even reaching
            the last row.
          </p>
          <a class="button" href="https://www.figma.com/design/jI3Rz8XUET6a23fWklJboC/DND-Playground?m=auto" target="_blank" rel="noopener" data-reveal="pop">
            View the session’s Figma file <Icon name="arrow-up-right" size={14} />
          </a>
        </div>
      </div>

      <Stats
        items={[
          { value: 1200, suffix: '+', label: 'Keynote audience' },
          { value: 25, suffix: '+', label: 'Creatives team members led' },
          { value: 60, suffix: '%', label: 'Growth in social and brand reach' },
        ]}
      />

      <div class="about__split">
        <figure class="about__photo" data-reveal="rise">
          <img src={photo('OTPxTudX76HLA4aECqRAszesUc')} alt="Members of the GDG SRM Creatives Team" loading="lazy" decoding="async" />
        </figure>
        <div class="about__copy" data-stagger="110">
          <h3 class="about__heading" data-reveal>Leading the Creatives Team</h3>
          {gdg.points.slice(0, 2).map((p) => <p data-reveal>{p}</p>)}
          <p data-reveal>
            From themes, logos and mascots to posts, reels and certificates, the team covered everything that carried the
            club’s name, and I couldn’t be more proud of their contribution.
          </p>
          <a class="link-arrow" href={url('/projects/events-booking-portal/')} data-reveal>Event Booking Portal case study <Icon name="arrow-right" size={16} /></a>
          <a class="link-arrow" href={url('/visual/')} data-reveal>See the team’s campaigns <Icon name="arrow-right" size={16} /></a>
        </div>
      </div>

      <article class="lead-card lead-card--compact" data-reveal="rise">
        <header class="lead-card__head">
          <p class="lead-card__org"><Icon name="users" size={18} /> {tedx.org}, {tedx.location}</p>
          <ul class="lead-card__roles">
            {tedx.roles.map((r) => <li>{r.title} <span>{r.dates}</span></li>)}
          </ul>
        </header>
        <ul class="metrics">
          <li class="metric"><span class="metric__value">300+</span><span class="metric__label">attendees</span></li>
          <li class="metric"><span class="metric__value">10+</span><span class="metric__label">vendors managed</span></li>
        </ul>
        <ul class="xp-role__points">
          {tedx.points.map((p) => <li>{p}</li>)}
        </ul>
      </article>
    </section>

    <hr class="about__divider" data-reveal="line" />

    <!-- Skills and education -->
    <section id="skills" class="about__block" aria-labelledby="skills-title">
      <div class="section-intro">
        <div>
          <p class="eyebrow" data-reveal><span class="eyebrow__num">{n('skills')}</span> Skills and education</p>
          <h2 id="skills-title" class="section-intro__title" data-reveal="blur">Research, design and build</h2>
        </div>
      </div>
      <div class="skills-edu">
        <SkillsTabs />
        <Education />
      </div>
    </section>

    <hr class="about__divider" data-reveal="line" />

    <!-- Recognition -->
    <section id="recognition" class="about__block" aria-labelledby="recognition-title">
      <div class="section-intro">
        <div>
          <p class="eyebrow" data-reveal><span class="eyebrow__num">{n('recognition')}</span> Recognition</p>
          <h2 id="recognition-title" class="section-intro__title" data-reveal="blur">Achievements and certifications</h2>
        </div>
      </div>
      <ul class="awards" data-stagger="90">
        {
          achievements.map((a) => (
            <li class="award" data-reveal="pop">
              <span class="award__icon"><Icon name={a.place === 'Scholarship' ? 'medal' : 'trophy'} size={20} /></span>
              <span class="award__place">{a.place}</span>
              <span class="award__title">{a.title}</span>
              <span class="award__by">{a.by}</span>
            </li>
          ))
        }
      </ul>
      <ul class="certs" data-stagger="70">
        {
          certifications.map((c) => (
            <li class="cert" data-reveal="left">
              <Icon name="certificate" size={18} class="cert__icon" />
              <span class="cert__name">{c.name}</span>
              <span class="cert__issuer">{c.issuer}</span>
              <span class="cert__date">{c.date}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <hr class="about__divider" data-reveal="line" />

    <section id="faq" class="about__block" aria-label="Questions">
      <Faq
        title="Frequently asked"
        items={[
          { q: 'What kind of work are you looking for?', a: 'Product design for data platforms that operations teams rely on daily, where research, design and building in code all matter.' },
          { q: 'Do you code?', a: 'Yes. I build my own projects in React, TypeScript and Tailwind CSS, such as OrgGrid, FundLookup and Handl, and I am comfortable with HTML, CSS, JavaScript, SQL, Python and Node.js.' },
          { q: 'How do you approach research?', a: 'Through stakeholder and user interviews, workflow mapping, competitive analysis and usability studies, then turning findings into personas, journey maps and prioritised problems.' },
          { q: 'Which tools do you use?', a: 'Figma at an advanced level for prototyping, wireframing, interaction and visual design and design systems, plus Framer and Photoshop.' },
          { q: 'Where are you based?', a: 'Bengaluru, India.' },
        ]}
      />
    </section>

    <hr class="about__divider" data-reveal="line" />

    <p class="about__lead about__closing" data-reveal="blur">
      Crafting intuitive interfaces that blend form and function, I strive to shape memorable interactions that{' '}
      <em class="accent">resonate</em>.
    </p>
  </div>
  <aside class="cs__right">
    <Toc sections={toc} />
  </aside>
  </div>
</Base>
