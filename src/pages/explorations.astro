---
import Base from '../layouts/Base.astro';
import FileAnatomy from '../components/case/FileAnatomy.astro';
import { explorations } from '../data/projects';
import { filesFor } from '../data/figma';
import { site } from '../config/site';
import { url } from '../lib/url';
---

<Base
  title={`Explorations | ${site.name}`}
  description="Design concepts in progress by Sai Rohit: an e-commerce marketplace and a news website, with every page, frame and label from their Figma files."
  wide
>
  <div class="container page-hero">
    <p class="eyebrow" data-reveal>Explorations</p>
    <h1 class="page-hero__title" data-reveal="blur">Concepts in the making</h1>
    <p class="page-hero__lead" data-reveal>
      Ideas that live in Figma and are on their way to becoming full case studies. Here is everything inside their files.
    </p>
  </div>
  {
    explorations.map((e) => (
      <section id={e.slug} class="container explore-block" aria-labelledby={`${e.slug}-title`}>
        <hr class="cs-divider" data-reveal="line" />
        <div class="explore-block__intro">
          <img src={url(e.image)} alt={`${e.title} preview`} loading="lazy" decoding="async" data-reveal="rise" />
          <div>
            <h2 id={`${e.slug}-title`} class="section-intro__title" data-reveal="blur">{e.title}</h2>
            <p class="section-intro__text" data-reveal>{e.description}</p>
            <ul class="chips" data-reveal>{e.tags.map((t) => <li class="chip">{t}</li>)}</ul>
          </div>
        </div>
        <FileAnatomy files={filesFor('exploration', e.slug)} />
      </section>
    ))
  }
</Base>
